# ─────────────────────────────────────────────────────────────────────────────
# FraudCall Detector backend — environment template
# Copy to `.env` and edit. Every value below is optional; the defaults shown
# are what the server uses when the variable is absent.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_DEBUG=true
# Generate one for production, e.g.:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-key-change-in-production
# Comma-separated. "*" is fine for local device testing. For production use the
# real host(s), e.g. "fraud.internal.example.com".
DJANGO_ALLOWED_HOSTS=*

# ── API auth ─────────────────────────────────────────────────────────────────
# Empty = open API (what the shipped app expects — it sends no auth header).
# If you set a key, the app's AuthInterceptor must send:
#   Authorization: Bearer <key>      (or X-Api-Key: <key>)
FRAUD_API_KEY=

# ── Fraud model ──────────────────────────────────────────────────────────────
# Defaults to ../fraud_detection_package/fraud_rf_model.joblib
# FRAUD_MODEL_PATH=/absolute/path/to/fraud_rf_model.joblib
MODEL_VERSION=rf-cuml-tfidf

# Binary fraud/normal decision threshold on the model probability (0..1).
FRAUD_DECISION_THRESHOLD=0.5

# Transcripts shorter than this are returned SAFE without invoking the model.
FRAUD_MIN_TRANSCRIPT_CHARS=5

# Max number of `signals[]` entries returned.
FRAUD_MAX_SIGNALS=5

# Risk-level banding. `risk_score < band` maps to that level; anything above
# the last band is CRITICAL. Must be strictly increasing.
# The app's default alert config is `risk_score >= 0.60` AND level >= MEDIUM,
# so keeping MEDIUM at 0.50 is what makes in-call alerts fire.
FRAUD_BAND_SAFE_MAX=0.30
FRAUD_BAND_LOW_MAX=0.50
FRAUD_BAND_MEDIUM_MAX=0.70
FRAUD_BAND_HIGH_MAX=0.90

# ── Speech-to-text ───────────────────────────────────────────────────────────
WHISPER_MODEL=tiny
# "cuda" is the default: the app times out after 30 s, and a 15 s chunk takes a
# few seconds on GPU vs tens of seconds on CPU here. Falls back to CPU automatically
# if CUDA cannot be initialised. "cpu" keeps VRAM free for cuML.
WHISPER_DEVICE=cuda
# WHISPER_DOWNLOAD_ROOT=/absolute/path/to/whisper-cache
# 1 = fastest (greedy). Raise to 5 for better accuracy at higher latency.
WHISPER_BEAM_SIZE=1
# Only used on the CPU fallback. 0 = auto (capped at 2). Torch's default can be
# 2x the core count, which thrashed OpenMP badly (3 s clip: 353 s @12 threads).
WHISPER_CPU_THREADS=0

# ── Limits / privacy ─────────────────────────────────────────────────────────
# Reject audio uploads above this size.
MAX_AUDIO_MB=25
# Persist raw transcript text in SQLite. Off by default (contains call PII).
LOG_TRANSCRIPTS=false
# `manage.py prune_logs` deletes DetectionLog/TranscriptionLog rows older than
# this many days. Set 0 to disable. Run from cron/timer for long-lived installs.
LOG_RETENTION_DAYS=30

# ── Startup ──────────────────────────────────────────────────────────────────
# Load cuML + Whisper in a background thread on process start.
PRELOAD_MODELS=true

# INFO | DEBUG | WARNING
LOG_LEVEL=INFO
